APP_NAME=PaperLens
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# With DEBUG=false the app REFUSES to start unless this is changed -- see
# Settings.model_post_init in app/config.py.
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Access tokens are short-lived and held in the browser's memory only; the
# session lives in an httpOnly refresh cookie. See app/routers/auth.py.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Storage ---
# SQLite holds everything: users, papers, chunk text, and chunk embeddings as
# float32 blobs. There is no separate vector database.
DATABASE_URL=sqlite:///./storage/paperlens.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
# Pages, not bytes: a 25 MB PDF can be 2,000 pages of embedding calls.
MAX_PAGES=400
INGEST_TIMEOUT_SECONDS=600
# Transcribe scanned PDFs with the model, one call per page. Off by default:
# it spends quota. See app/rag/ocr.py.
SCANNED_PDF_OCR=false
OCR_MAX_PAGES=30

# --- LLM ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned, not an alias like "gemini-flash-latest": an alias would silently
# change the model underneath a running deployment. Must match the value in
# render.yaml and the Dockerfile.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings ---
# Hosted, using the same API key as above. Running an embedding model locally
# would cost ~300MB of RAM, which does not fit the 512MB target instance.
# Changing either of these invalidates every stored embedding -- the vector
# store raises rather than ranking against mismatched dimensions, so you will
# get a clear error rather than silently wrong results. Re-upload to fix.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=64

# --- Chunking ---
# Tokens, not characters. ~1000-token chunks follow section and paragraph
# boundaries; see app/rag/chunker.py for why this is 4x the old size.
CHUNK_TARGET_TOKENS=1000
CHUNK_OVERLAP_TOKENS=120

# --- Retrieval and chat ---
TOP_K=10              # chunks sent to the model per question
QUERY_VARIANTS=3      # the question plus 2 rewrites, all fed into fusion
CHAT_RECENT_TURNS=6   # turns replayed verbatim before older ones are summarised

# --- Rate limiting (app/ratelimit.py) ---
# Per-user token buckets, in memory (correct: one process). A public demo on
# one free API key needs these; set RATE_LIMITING=false for local development.
RATE_LIMITING=true
RATE_CHAT_PER_MINUTE=12
RATE_INGEST_PER_HOUR=6
RATE_LOGIN_PER_MINUTE=10
DAILY_CALLS_PER_USER=300

# --- Concurrency ---
# Starlette's threadpool defaults to 40 threads and every endpoint here is sync.
# Applied in app/main.py; see the note there for why this is load-bearing for
# the memory budget rather than a performance tweak.
THREAD_LIMIT=2

# Empty on purpose. The Vite dev server proxies /api, and the deployed container
# serves the frontend from this same process, so in both cases the browser sees
# one origin and CORS never applies. Only fill this in if you serve the frontend
# from a separate host.
CORS_ORIGINS=
