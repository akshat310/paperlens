# Only needed if the frontend is ever served from a DIFFERENT origin than the
# API. It is not in the shipped setup: FastAPI serves this bundle itself, so
# src/api/client.ts falls back to a relative "/api" and CORS never applies.
#
# If you do split them, include the /api suffix, and add the frontend's origin
# to CORS_ORIGINS on the backend.
# VITE_API_URL=https://your-backend.example.com/api
